---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, services, methodSteps, testimonials, faqs } from "../data/site";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const asset = (path: string) => path.startsWith('http') ? path : `${baseUrl}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <!-- Acessibilidade: Atalho direto para o conteúdo principal -->
  <a href="#main-content" class="skip-link">Pular para o conteúdo principal</a>

  <div class="site-wrapper">
    <!-- ====================================================================
         HEADER FIXO GLOBAL
         ==================================================================== -->
    <header class="site-header" id="site-header">
      <div class="container header-container">
        <!-- Logotipo Oficial -->
        <a href="#inicio" class="header-brand" aria-label="Storm Automotive - Ir para o início">
          <img 
            src={asset(site.assets.logo)} 
            alt="Storm Automotive" 
            class="header-logo" 
            width="184" 
            height="40"
            fetchpriority="high"
          />
        </a>

        <!-- Navegação Desktop -->
        <nav class="site-nav" aria-label="Navegação Principal">
          <ul class="nav-list">
            <li><a href="#inicio" class="nav-link">Início</a></li>
            <li><a href="#servicos" class="nav-link">Serviços</a></li>
            <li><a href="#sobre" class="nav-link">Sobre</a></li>
            <li><a href="#estrutura" class="nav-link">Nossa Estrutura</a></li>
            <li><a href="#contato" class="nav-link">Contato</a></li>
          </ul>
        </nav>

        <!-- Ações do Header: CTA e Toggle Mobile -->
        <div class="header-actions">
          <a 
            href={site.whatsappUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn btn--header header-cta"
            data-storm-href="brand.whatsappHref"
          >
            <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span>Agendar atendimento</span>
          </a>

          <!-- Botão Hamburger para Mobile -->
          <button 
            class="mobile-toggle" 
            id="hamburgerBtn" 
            type="button"
            aria-label="Abrir menu de navegação" 
            aria-expanded="false" 
            aria-controls="mobileMenu"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Drawer Mobile Acessível -->
    <div class="mobile-drawer" id="mobile-drawer" aria-label="Menu móvel">
      <div class="mobile-drawer-header">
        <img src={asset(site.assets.logo)} alt="Storm Automotive" class="header-logo" width="147" height="32" />
        <button class="mobile-drawer-close" id="mobile-menu-close" type="button" aria-label="Fechar menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-drawer-nav">
        <ul class="mobile-nav-list mobile-nav">
          <li><a href="#inicio" class="mobile-nav-link">Início</a></li>
          <li><a href="#servicos" class="mobile-nav-link">Serviços</a></li>
          <li><a href="#sobre" class="mobile-nav-link">Sobre</a></li>
          <li><a href="#estrutura" class="mobile-nav-link">Nossa Estrutura</a></li>
          <li><a href="#contato" class="mobile-nav-link">Contato</a></li>
        </ul>
      </nav>

      <div class="mobile-drawer-footer">
        <a 
          href={site.whatsappUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn--primary"
          data-storm-href="brand.whatsappHref"
        >
          <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Agendar atendimento</span>
        </a>
      </div>
    </div>
    <div class="mobile-backdrop" id="mobile-backdrop" aria-hidden="true"></div>

    <!-- ====================================================================
         CONTEÚDO PRINCIPAL
         ==================================================================== -->
    <main id="main-content" class="site-main" tabindex="-1">
      <!-- HERO INSTITUCIONAL STORM AUTOMOTIVE -->
      <section class="hero-section" id="inicio" aria-label="Apresentação Storm Automotive">
        <!-- Fotografia Real HQ de Fundo com Sobreposição Editorial de Alto Contraste -->
        <div class="hero-backdrop">
          <img 
            src={asset(site.assets.hero)} 
            alt="Oficina mecânica de alta precisão Storm Automotive com carros premium e infraestrutura de ponta" 
            class="hero-bg-img"
            width="1792"
            height="877"
            fetchpriority="high"
          />
          <div class="hero-overlay" aria-hidden="true"></div>
        </div>

        <div class="container hero-container">
          <div class="hero-content">
            <!-- Eyebrow -->
            <div class="hero-eyebrow eyebrow">
              <span>OFICINA MECÂNICA PREMIUM</span>
              <span class="eyebrow-separator" aria-hidden="true"></span>
            </div>

            <!-- Título Principal de Alto Impacto -->
            <h1 class="hero-title">
              SEU VEÍCULO<br />
              <span class="text-accent highlight">EM BOAS MÃOS</span>
            </h1>

            <!-- Subtítulo -->
            <p class="hero-subtitle hero-tagline">
              Manutenção, tecnologia e confiança para você ir sempre mais longe.
            </p>

            <!-- Ações Principais (CTAs) -->
            <div class="hero-actions">
              <a 
                href={site.whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn btn--primary hero-btn hero-btn--primary"
                data-storm-href="brand.whatsappHref"
              >
                <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Agendar atendimento</span>
                <svg class="btn-icon btn-arrow-right" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>

              <a href="#servicos" class="btn btn--outline hero-btn hero-btn--secondary desktop-only">
                <span>Conheça nossos serviços</span>
                <svg class="btn-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            <!-- FAIXA DE CONFIANÇA 1 (MICRO-FEATURES SOB OS CTAS) -->
            <ul class="hero-trust-strip" aria-label="Diferenciais operacionais">
              <li class="trust-strip-item">
                <div class="trust-icon-wrapper">
                  <svg class="trust-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                    <path d="m3.8 14.8 5.4-5.4"></path>
                  </svg>
                </div>
                <div class="trust-text">
                  <span class="trust-title">ATENDIMENTO</span>
                  <span class="trust-sub">ESPECIALIZADO</span>
                </div>
              </li>

              <li class="trust-strip-divider" aria-hidden="true"></li>

              <li class="trust-strip-item">
                <div class="trust-icon-wrapper">
                  <svg class="trust-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                  </svg>
                </div>
                <div class="trust-text">
                  <span class="trust-title">TRANSPARÊNCIA</span>
                  <span class="trust-sub">EM CADA ETAPA</span>
                </div>
              </li>

              <li class="trust-strip-divider" aria-hidden="true"></li>

              <li class="trust-strip-item">
                <div class="trust-icon-wrapper">
                  <svg class="trust-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="trust-text">
                  <span class="trust-title">EM IJUÍ – RS</span>
                  <span class="trust-sub">HÁ MAIS DE 14 ANOS</span>
                </div>
              </li>
            </ul>
          </div>
        </div>

        <!-- FAIXA DE CONFIANÇA 2 (BARRA INFERIOR COMPACTA E ESTRUTURADA) -->
        <aside class="hero-features-bar" aria-label="Pilares de excelência técnica">
          <div class="container features-bar-container">
            <div class="feature-item">
              <div class="feature-icon-wrapper">
                <svg class="feature-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </div>
              <div class="feature-text">
                <span class="feature-title">Veículos<br class="feature-break-mobile" /> Nacionais</span>
                <span class="feature-subtitle">e Importados</span>
              </div>
            </div>

            <div class="features-bar-divider" aria-hidden="true"></div>

            <div class="feature-item">
              <div class="feature-icon-wrapper">
                <svg class="feature-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 12 10s-6.7.6-8.5 1.1C2.7 11.3 2 12.1 2 13v3c0 .6.4 1 1 1h2"></path>
                  <circle cx="7" cy="17" r="2"></circle>
                  <path d="M9 17h6"></path>
                  <circle cx="17" cy="17" r="2"></circle>
                  <path d="m4.6 11 1.8-4.2C6.8 5.7 7.9 5 9.1 5h5.8c1.2 0 2.3.7 2.7 1.8l1.8 4.2"></path>
                </svg>
              </div>
              <div class="feature-text">
                <span class="feature-title">Equipamentos</span>
                <span class="feature-subtitle">de Última<br class="feature-break-mobile" /> Geração</span>
              </div>
            </div>

            <div class="features-bar-divider" aria-hidden="true"></div>

            <div class="feature-item">
              <div class="feature-icon-wrapper">
                <svg class="feature-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="feature-text">
                <span class="feature-title">Equipe Técnica</span>
                <span class="feature-subtitle">Qualificada</span>
              </div>
            </div>
          </div>
        </aside>
      </section>

      <!-- ====================================================================
           SEÇÃO NOSSOS SERVIÇOS
           ==================================================================== -->
      <section class="services-section" id="servicos" aria-label="Nossos Serviços">
        <div class="container">
          <!-- Cabeçalho da Seção -->
          <div class="services-header">
            <div class="services-header-left">
              <div class="services-eyebrow">
                <span>NOSSOS SERVIÇOS</span>
                <span class="eyebrow-line" aria-hidden="true"></span>
              </div>
              <h2 class="services-title">
                MANUTENÇÃO COMPLETA<br />
                <span class="text-accent">PARA O SEU VEÍCULO</span>
              </h2>
            </div>

            <div class="services-header-right">
              <p class="services-intro">
                Aqui seu carro recebe o cuidado que ele merece, com técnica, experiência e equipamentos de ponta.
              </p>
            </div>
          </div>

          <!-- Grade Assimétrica Editorial -->
          <div class="services-grid">
            <!-- Card 01 (Alto): Revisão Preventiva -->
            <a 
              href={`${site.whatsappUrl}&text=Ol%C3%A1!%20Gostaria%20de%20agendar%20uma%20Revis%C3%A3o%20Preventiva.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="service-card service-card--tall"
            >
              <div class="service-card-media">
                <img 
                  src={asset(services[0].image)} 
                  alt={services[0].alt}
                  class="service-card-img" 
                  width="1122" 
                  height="1402"
                  loading="lazy"
                />
                <div class="service-card-overlay" aria-hidden="true"></div>
              </div>
              <div class="service-card-body">
                <div class="service-number">
                  <span>01</span>
                  <span class="service-number-bar" aria-hidden="true"></span>
                </div>
                <h3 class="service-title" set:html={services[0].title.replace(/\n/g, '<br/>')}></h3>
                <p class="service-desc" set:html={services[0].description.replace(/\n/g, '<br/>')}></p>
              </div>
              <div class="service-action" aria-hidden="true">
                <span class="service-circle-btn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </a>

            <!-- Coluna Central: Dois Cards Horizontais Empilhados -->
            <div class="services-column-center">
              <!-- Card 02 (Horizontal): Diagnóstico Eletrônico -->
              <a 
                href={`${site.whatsappUrl}&text=Ol%C3%A1!%20Gostaria%20de%20um%20Diagn%C3%B3stico%20Eletr%C3%B4nico.`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="service-card service-card--horizontal"
              >
                <div class="service-card-media">
                  <img 
                    src={asset(services[1].image)} 
                    alt={services[1].alt}
                    class="service-card-img" 
                    width="1672" 
                    height="941"
                    loading="lazy"
                  />
                  <div class="service-card-overlay" aria-hidden="true"></div>
                </div>
                <div class="service-card-body">
                  <div class="service-number">
                    <span>02</span>
                    <span class="service-number-bar" aria-hidden="true"></span>
                  </div>
                  <h3 class="service-title" set:html={services[1].title.replace(/\n/g, '<br/>')}></h3>
                  <p class="service-desc" set:html={services[1].description.replace(/\n/g, '<br/>')}></p>
                </div>
                <div class="service-action" aria-hidden="true">
                  <span class="service-circle-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>

              <!-- Card 03 (Horizontal): Manutenção Especializada -->
              <a 
                href={`${site.whatsappUrl}&text=Ol%C3%A1!%20Gostaria%20de%20or%C3%A7amento%20para%20Manuten%C3%A7%C3%A3o%20Especializada.`} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="service-card service-card--horizontal service-card--collapsible"
                id="service-card-03"
              >
                <div class="service-card-media">
                  <img 
                    src={asset(services[2].image)} 
                    alt={services[2].alt}
                    class="service-card-img" 
                    width="1672" 
                    height="941"
                    loading="lazy"
                  />
                  <div class="service-card-overlay" aria-hidden="true"></div>
                </div>
                <div class="service-card-body">
                  <div class="service-number">
                    <span>03</span>
                    <span class="service-number-bar" aria-hidden="true"></span>
                  </div>
                  <h3 class="service-title" set:html={services[2].title.replace(/\n/g, '<br/>')}></h3>
                  <p class="service-desc" set:html={services[2].description.replace(/\n/g, '<br/>')}></p>
                </div>
                <div class="service-action" aria-hidden="true">
                  <span class="service-circle-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </a>
            </div>

            <!-- Card 04 (Alto): Ar-Condicionado -->
            <a 
              href={`${site.whatsappUrl}&text=Ol%C3%A1!%20Gostaria%20de%20revisar%20o%20sistema%20de%20Ar-Condicionado.`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="service-card service-card--tall service-card--collapsible"
              id="service-card-04"
            >
              <div class="service-card-media">
                <img 
                  src={asset(services[3].image)} 
                  alt={services[3].alt}
                  class="service-card-img" 
                  width="1122" 
                  height="1402" 
                  loading="lazy"
                />
                <div class="service-card-overlay" aria-hidden="true"></div>
              </div>
              <div class="service-card-body">
                <div class="service-number">
                  <span>04</span>
                  <span class="service-number-bar" aria-hidden="true"></span>
                </div>
                <h3 class="service-title" set:html={services[3].title.replace(/\n/g, '<br/>')}></h3>
                <p class="service-desc" set:html={services[3].description.replace(/\n/g, '<br/>')}></p>
              </div>
              <div class="service-action" aria-hidden="true">
                <span class="service-circle-btn">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <!-- ====================================================================
           SEÇÃO SOBRE A STORM
           ==================================================================== -->
      <section class="about-section" id="sobre" aria-label="Sobre a Storm Automotive">
        <div class="container">
          <div class="about-grid">
            <!-- Coluna Esquerda: Fotografia Real da Equipe -->
            <div class="about-media-col">
              <div class="about-media-wrapper">
                <img 
                  src={asset("https://stormautomotive.vercel.app/assets/images/storm/equipe-storm-hq.png")} 
                  alt="Equipe de especialistas e proprietários da Storm Automotive em Ijuí–RS" 
                  class="about-img" 
                  width="1122" 
                  height="1402"
                  loading="lazy"
                />
                <div class="about-badge desktop-only" aria-label="+14 anos de história em Ijuí - RS">
                  <span class="about-badge-slash" aria-hidden="true">/</span>
                  <div class="about-badge-content">
                    <strong class="about-badge-value">+14 ANOS</strong>
                    <span class="about-badge-label">DE HISTÓRIA EM IJUÍ - RS</span>
                  </div>
                </div>

                <!-- CTA sobre a foto no mobile conforme mockup -->
                <a 
