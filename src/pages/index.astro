                  <span class="contact-info-sub">{site.address.split(',')[0]}</span>
                  <a href={site.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="contact-map-link mobile-only">Como chegar &rarr;</a>
                </div>
              </div>

              <!-- Telefone Direto -->
              <div class="contact-info-item">
                <div class="contact-info-icon-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="contact-info-text">
                  <span class="contact-info-label">Telefone Direto</span>
                  <a href={`tel:+${site.phoneRaw}`} class="contact-info-value">{site.phoneDisplay}</a>
                  <span class="contact-info-sub">Atendimento comercial e orçamentos</span>
                </div>
              </div>

              <!-- Horário de Atendimento -->
              <div class="contact-info-item">
                <div class="contact-info-icon-circle" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <div class="contact-info-text">
                  <span class="contact-info-label">Horário de Atendimento</span>
                  <span class="contact-info-value">Segunda a Sexta: 8h às 12h e 13h30 às 18h</span>
                  <span class="contact-info-sub">Sábado: 8h às 12h</span>
                </div>
              </div>
            </div>

            <!-- Coluna 3: Card com Mapa Google Real (Desktop) -->
            <div class="contact-map-col desktop-only">
              <div class="contact-map-card">
                <iframe 
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3509.9481966097933!2d-53.92477948730591!3d-28.390632575696802!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94fc2d6871a24d35%3A0x3183f95ef3207d01!2sStorm%20Automotive!5e0!3m2!1spt-BR!2sbr!4v1789077887473!5m2!1spt-BR!2sbr" 
                  class="contact-map-iframe"
                  width="600" 
                  height="450" 
                  style="border:0;" 
                  allowfullscreen={true} 
                  loading="lazy" 
                  referrerpolicy="strict-origin-when-cross-origin"
                  title="Localização da Storm Automotive no Google Maps"
                ></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ====================================================================
         RODAPÉ GLOBAL
         ==================================================================== -->
    <footer class="site-footer" id="site-footer">
      <div class="container">
        <div class="footer-grid">
          <!-- Coluna 1: Logo & Tagline Oficial -->
          <div class="footer-brand-col">
            <a href="#inicio" class="footer-logo-link" aria-label="Storm Automotive - Voltar ao início">
              <img 
                src={asset(site.assets.logo)} 
                alt="Storm Automotive" 
                class="footer-logo" 
                width="160" 
                height="35"
                loading="lazy"
              />
            </a>
            <p class="footer-tagline">
              Mais que mecânica, confiança em movimento.
            </p>
          </div>

          <!-- Coluna 2: Navegação -->
          <div class="footer-nav-col">
            <h3 class="footer-col-title">NAVEGAÇÃO</h3>
            <ul class="footer-nav-list">
              <li><a href="#inicio" class="footer-nav-link">Início</a></li>
              <li><a href="#servicos" class="footer-nav-link">Serviços</a></li>
              <li><a href="#sobre" class="footer-nav-link">Sobre</a></li>
              <li><a href="#estrutura" class="footer-nav-link">Nossa Estrutura</a></li>
              <li><a href="#contato" class="footer-nav-link">Contato</a></li>
            </ul>
          </div>

          <!-- Coluna 3: Contato -->
          <div class="footer-contact-col">
            <h3 class="footer-col-title">CONTATO</h3>
            <ul class="footer-contact-list">
              <li class="footer-contact-item">
                <span class="footer-contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </span>
                <span class="footer-contact-text">{site.locationDisplay}</span>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </span>
                <a href={`tel:+${site.phoneRaw}`} class="footer-contact-link">{site.phoneDisplay}</a>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M22 6l-10 7L2 6"></path>
                  </svg>
                </span>
                <a href={`mailto:${site.email}`} class="footer-contact-link">{site.email}</a>
              </li>
              <li class="footer-contact-item">
                <span class="footer-contact-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </span>
                <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-contact-link">{site.instagramHandle}</a>
              </li>
            </ul>
          </div>

          <!-- Coluna 4: Redes Sociais -->
          <div class="footer-social-col">
            <h3 class="footer-col-title">SIGA A STORM</h3>
            <div class="footer-social-list">
              <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Siga a Storm Automotive no Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>

              <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Siga a Storm Automotive no Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Barra Final -->
        <div class="footer-bottom-bar">
          <div class="footer-copyright">
            <span>&copy; {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</span>
          </div>
          
          <div class="footer-developer">
            Desenvolvido por <a href="https://jeankist.com/" target="_blank" rel="noopener noreferrer">Jean Kist</a> &copy; {new Date().getFullYear()}
          </div>

          <div class="footer-legal-links">
            <a href="#privacidade" class="footer-legal-link">Política de Privacidade</a>
            <span class="footer-legal-separator" aria-hidden="true">&bull;</span>
            <a href="#termos" class="footer-legal-link">Termos de Uso</a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
